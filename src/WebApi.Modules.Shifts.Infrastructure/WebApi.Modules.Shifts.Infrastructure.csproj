<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="soft.square.net.ModularBlazor.Module.Sdk" />

  <!--
    Infrastructure: the tenant DbContext (Data/ShiftsDbContext.cs), the entity mappings (Data/Config) and the
    migrations, one set per engine (Data/Migrations/<Provider>). References Core only.
    The Module SDK compiles it against WebApi.Data (EF Core, TenantDbContext, repositories), provided by the host, and
    makes it loadable on its own (EnableDynamicLoading), which dotnet-ef needs to add migrations to this project.
    It is not the entry assembly: WebApi.Modules.Shifts.Web is.
  -->

  <ItemGroup>
    <ProjectReference Include="..\WebApi.Modules.Shifts.Core\WebApi.Modules.Shifts.Core.csproj" />
  </ItemGroup>

</Project>
