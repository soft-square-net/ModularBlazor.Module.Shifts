@using soft.square.net.Module.Shifts.Model
@inject IStringLocalizerFactory Texts

@*
  The shift form shared by "New shift" and "Edit shift": what it is planned for (a unit, or a section that has not
  moved to the Organization tree), start and end on the clock named under them, and the rota (user ids with a role:
  the role definitions that hold for the shift's unit, or the tenant's). The API checks the rules (end after start,
  at most 24 hours, one lead before publishing, a role the unit has) and answers with the reason.
*@

<form class="sh-card sh-form" @onsubmit="Save" @onsubmit:preventDefault>
  <h2 class="mud-typography mud-typography-subtitle1">@Title</h2>

  @if (Form.UnitId is not null)
  {
    <p>@L["Unit"]: <strong>@UnitName</strong></p>
  }
  else
  {
    <div class="mud-input-control">
      <label class="mud-input-label" for="sh-section">@L["Section"]</label>
      <div class="mud-input-wrapper mud-input-wrapper--select">
        <select id="sh-section" class="mud-input-slot" value="@Form.SectionId" required @onchange="e => Form.SectionId = e.Value?.ToString() ?? string.Empty">
          <option value="" selected="@(Form.SectionId.Length == 0)">@L["Choose a section."]</option>
          @foreach (var section in Sections)
          {
            var id = section.Id.ToString(System.Globalization.CultureInfo.InvariantCulture);
            <option value="@id" selected="@(Form.SectionId == id)">@section.Name</option>
          }
        </select>
      </div>
    </div>
  }

  <div class="sh-grid">
    <div class="mud-input-control">
      <label class="mud-input-label" for="sh-start">@L["Starts"]</label>
      <div class="mud-input-wrapper"><input id="sh-start" class="mud-input-slot" type="datetime-local" dir="ltr" value="@Form.StartsAt" @onchange="e => Form.StartsAt = e.Value?.ToString() ?? string.Empty" required /></div>
    </div>
    <div class="mud-input-control">
      <label class="mud-input-label" for="sh-end">@L["Ends"]</label>
      <div class="mud-input-wrapper"><input id="sh-end" class="mud-input-slot" type="datetime-local" dir="ltr" value="@Form.EndsAt" @onchange="e => Form.EndsAt = e.Value?.ToString() ?? string.Empty" required /></div>
    </div>
  </div>
  <p class="sh-muted">@L["Times are in this clock: {0}.", ZoneName]</p>

  <fieldset class="sh-rota">
    <legend>@L["Rota"]</legend>
    <p class="sh-muted">@L["Each member by user id, with a role. Publishing needs exactly one lead."]</p>
    @foreach (var (row, index) in Form.Rota.Select((r, i) => (r, i)))
    {
      <div class="sh-rota-row" @key="row">
        <input class="mud-input-slot" aria-label="@L["User id of member {0}", index + 1]" placeholder="@L["User id"]" dir="ltr" @bind="row.UserId" />
        <select class="mud-input-slot" aria-label="@L["Role of member {0}", index + 1]" value="@row.RoleKey" @onchange="e => row.RoleKey = e.Value?.ToString() ?? row.RoleKey">
          @foreach (var option in RoleChoices.For(Roles, row.RoleKey, Arabic, key => L[key]))
          {
            <option value="@option.Key" selected="@(option.Key == row.RoleKey)">@option.Name@(option.IsLead ? " · " + L["lead"] : "")</option>
          }
        </select>
        <button type="button" class="mud-button-root mud-button-text mud-button-primary mud-button-small" @onclick="() => Form.Rota.Remove(row)">@L["Remove"]</button>
      </div>
    }
    <div class="sh-actions">
      <button type="button" class="mud-button-root mud-button-text mud-button-primary mud-button-small" @onclick="() => Form.Rota.Add(new())">@L["Add a member"]</button>
      @if (!string.IsNullOrEmpty(Me) && !Form.Rota.Any(r => r.UserId == Me))
      {
        <button type="button" class="mud-button-root mud-button-text mud-button-primary mud-button-small" @onclick="() => Form.Rota.Add(new() { UserId = Me! })">@L["Add me"]</button>
      }
    </div>
  </fieldset>

  <div class="sh-actions">
    <button type="submit" class="mud-button-root mud-button-filled mud-button-primary" disabled="@Busy">@(Busy ? L["Saving…"] : SubmitText)</button>
    <button type="button" class="mud-button-root mud-button-text mud-button-surface" @onclick="OnCancel">@L["Cancel"]</button>
  </div>
</form>

@code {
  [Parameter, EditorRequired] public ShiftForm Form { get; set; } = default!;
  [Parameter, EditorRequired] public string Title { get; set; } = "";
  [Parameter, EditorRequired] public string SubmitText { get; set; } = "";
  /// <summary>The sections a shift without a unit can be planned on: those that have not moved.</summary>
  [Parameter] public IReadOnlyList<soft.square.net.WebApi.Modules.Shifts.Client.SectionDto> Sections { get; set; } = [];
  [Parameter] public string UnitName { get; set; } = "";
  [Parameter, EditorRequired] public string ZoneName { get; set; } = "";
  /// <summary>The role definitions that hold for the shift's unit (GET /roles/effective).</summary>
  [Parameter] public IReadOnlyList<soft.square.net.WebApi.Modules.Shifts.Client.RoleDefinitionDto> Roles { get; set; } = [];
  [Parameter] public bool Busy { get; set; }
  /// <summary>The signed-in user's id, so "Add me" can fill it in.</summary>
  [Parameter] public string? Me { get; set; }
  [Parameter] public EventCallback OnSave { get; set; }
  [Parameter] public EventCallback OnCancel { get; set; }

  private IStringLocalizer? _l;
  private IStringLocalizer L => _l ??= Texts.Create(typeof(ShiftsPageBase));

  private static bool Arabic => System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";

  private Task Save() => OnSave.InvokeAsync();
}
