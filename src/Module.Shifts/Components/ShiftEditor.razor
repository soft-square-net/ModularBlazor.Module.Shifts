@*
  The shift form shared by "New shift" and "Edit shift": section, start and end (local time) and the rota (user ids
  with a role: the role definitions that hold for the shift's unit, or the tenant's). The API checks the rules (end after
  start, a known section, role keys that hold for the unit, at most one lead).
*@

<section class="mud-paper mud-elevation-2 sh-card">
  <h2 class="mud-typography mud-typography-h6">@(Title ?? L["New shift"])</h2>
  @if (Sections.Count == 0)
  {
    <p class="mud-typography mud-typography-body2 sh-muted">
      There are no sections yet. Add one on <a href="shifts/sections">@L["Sections"]</a> first.
    </p>
  }
  <form class="sh-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
    <div class="sh-grid">
      <div class="mud-input-control">
        <label class="mud-input-label" for="sh-section">@L["Section"]</label>
        <div class="mud-input-wrapper mud-input-wrapper--select">
          <select id="sh-section" class="mud-input-slot" @bind="Form.SectionId" required disabled="@SectionLocked">
            <option value="">@L["Choose…"]</option>
            @foreach (var section in Sections.OrderBy(s => s.Name))
            {
              <option value="@section.Id">@(section.Kind == SectionKind.Department ? L["{0} (department)", section.Name] : section.Name)</option>
            }
          </select>
        </div>
        @if (SectionLocked)
        {
          <div class="mud-input-helper-text">@L["A shift keeps its section. Delete it and plan a new one to move it."]</div>
        }
      </div>
      <div class="mud-input-control">
        <label class="mud-input-label" for="sh-start">@L["Starts"]</label>
        <div class="mud-input-wrapper">
          <input id="sh-start" type="datetime-local" class="mud-input-slot" value="@Form.StartsAt" @onchange="@(e => Form.StartsAt = e.Value?.ToString() ?? string.Empty)" required />
        </div>
      </div>
      <div class="mud-input-control">
        <label class="mud-input-label" for="sh-end">@L["Ends"]</label>
        <div class="mud-input-wrapper">
          <input id="sh-end" type="datetime-local" class="mud-input-slot" value="@Form.EndsAt" @onchange="@(e => Form.EndsAt = e.Value?.ToString() ?? string.Empty)" required />
        </div>
      </div>
    </div>

    <h3 class="mud-typography mud-typography-subtitle1">@L["Rota"]</h3>
    <p class="mud-typography mud-typography-body2 sh-muted">
      @L["Who works the shift (user ids) and as what. Publishing grants each member the role's permissions on the section's categories for the shift's time."]
    </p>
    <div class="sh-rota">
      @foreach (var (row, i) in Form.Rota.Select((r, i) => (r, i)).ToList())
      {
        <div class="sh-rota-row">
          <div class="mud-input-control sh-grow">
            <label class="mud-input-label" for="sh-rota-user-@i">@L["User id"]</label>
            <div class="mud-input-wrapper mud-input-wrapper--dense">
              <input id="sh-rota-user-@i" class="mud-input-slot" @bind="row.UserId" required maxlength="200" />
            </div>
          </div>
          <div class="mud-input-control sh-inline">
            <label class="mud-input-label" for="sh-rota-role-@i">@L["Role"]</label>
            <div class="mud-input-wrapper mud-input-wrapper--select mud-input-wrapper--dense">
              <select id="sh-rota-role-@i" class="mud-input-slot" @bind="row.RoleKey">
                @foreach (var (key, name) in RoleOptions(row.RoleKey))
                {
                  <option value="@key">@name</option>
                }
              </select>
            </div>
          </div>
          <button type="button" class="mud-button-root mud-button-text mud-button-error mud-button-medium" @onclick="() => Form.Rota.Remove(row)">@L["Remove"]</button>
        </div>
      }
    </div>
    <div class="sh-row-actions">
      <button type="button" class="mud-button-root mud-button-outlined mud-button-primary mud-button-small" @onclick="AddRow">@L["Add member"]</button>
      @if (Me is not null && Form.Rota.All(r => r.UserId != Me))
      {
        <button type="button" class="mud-button-root mud-button-outlined mud-button-primary mud-button-small" @onclick="AddMe">@L["Add me"]</button>
      }
    </div>

    <div class="sh-row-actions">
      <button type="submit" class="mud-button-root mud-button-filled mud-button-primary mud-button-medium" disabled="@(Busy || Sections.Count == 0)">@(SubmitText ?? L["Plan shift"])</button>
      <button type="button" class="mud-button-root mud-button-text mud-button-surface mud-button-medium" @onclick="OnCancel">@L["Cancel"]</button>
    </div>
  </form>
</section>

@code {
  [Inject] private IStringLocalizer<ShiftEditor> L { get; set; } = default!;

  [Parameter, EditorRequired] public ShiftForm Form { get; set; } = default!;
  [Parameter, EditorRequired] public IReadOnlyList<SectionDto> Sections { get; set; } = [];
  [Parameter] public string? Title { get; set; }
  [Parameter] public string? SubmitText { get; set; }
  [Parameter] public bool SectionLocked { get; set; }
  [Parameter] public bool Busy { get; set; }
  [Parameter] public string? Me { get; set; }
  /// <summary>The roles the rota can use (GET /roles/effective); the seeded manager, desk and editor when not loaded.</summary>
  [Parameter] public IReadOnlyList<RoleDefinitionDto> Roles { get; set; } = [];
  [Parameter] public EventCallback<ShiftForm> OnSave { get; set; }
  [Parameter] public EventCallback OnCancel { get; set; }

  private void AddRow() => Form.Rota.Add(new ShiftForm.RotaRow());

  private void AddMe() => Form.Rota.Add(new ShiftForm.RotaRow { UserId = Me!, RoleKey = "desk" });

  private static readonly (string Key, string Name)[] SeededRoles = [("manager", "manager"), ("desk", "desk"), ("editor", "editor")];

  /// <summary>Each role as (key, name in the UI language); a key the list lacks (a role removed since) stays selectable.</summary>
  private IEnumerable<(string Key, string Name)> RoleOptions(string current)
  {
    var arabic = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var options = Roles.Count == 0
      ? SeededRoles
      : Roles.Select(r => (r.Key, (arabic ? r.NameAr : r.NameEn) + (r.IsLead ? " ★" : ""))).ToArray();
    return options.Any(o => o.Key == current) || string.IsNullOrEmpty(current) ? options : [.. options, (current, current)];
  }

  private Task SubmitAsync() => OnSave.InvokeAsync(Form);
}
