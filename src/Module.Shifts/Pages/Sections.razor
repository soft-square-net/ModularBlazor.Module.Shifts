@page "/shifts/sections"
@inherits ShiftsPageBase

@*
  Moved sections, read-only (GET /api/shifts/sections): what became of the sections that came before the Organization
  tree. Each moved one names its unit; those still to move are listed apart, with a link to the page that moves them.
  Sections can no longer be added or changed: categories live on the units.
*@

<PageHeader Title="@L["Moved sections"]" />

<div class="mud-container sh-page">
  <ShiftsNav Current="sections" />

  <header class="sh-header">
    <p class="sh-muted">@L["Sections were replaced by the units of the Organization tree. They are read-only: change a unit's categories in Organization."]</p>
    <div class="sh-actions">
      <button type="button" class="mud-button-root mud-button-outlined mud-button-primary mud-button-medium" @onclick="LoadAsync" disabled="@Busy">@L["Refresh"]</button>
      <a class="mud-button-root mud-button-filled mud-button-primary mud-button-medium" href="shifts/sections/move">@L["Move sections"]</a>
    </div>
  </header>

  @if (Error is not null)
  {
    <p class="mud-typography mud-typography-body2 sh-error" role="alert" dir="auto">@Error</p>
  }

  @if (_sections is null)
  {
    @if (Error is null)
    {
      <p class="sh-muted">@L["Loading…"]</p>
    }
  }
  else
  {
    var unmoved = _sections.Where(s => s.MovedToUnitId is null).ToList();
    var moved = _sections.Where(s => s.MovedToUnitId is not null).ToList();

    @if (unmoved.Count > 0)
    {
      <section class="mud-paper mud-elevation-1 sh-card">
        <h2 class="mud-typography mud-typography-h6">@L["Not moved yet"]</h2>
        <p class="sh-banner">
          @L["These sections still work: their shifts can be planned, published, checked in and checked out. Move them to give them a unit."]
          <a href="shifts/sections/move">@L["Move sections"]</a>
        </p>
        @Table(unmoved, false)
      </section>
    }

    <section class="mud-paper mud-elevation-1 sh-card">
      <h2 class="mud-typography mud-typography-h6">@L["Moved to the Organization tree"]</h2>
      @if (moved.Count == 0)
      {
        <p class="sh-muted">@L["No section has moved."]</p>
      }
      else
      {
        @Table(moved, true)
      }
    </section>
  }
</div>

@code {
  private List<SectionDto>? _sections;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender) await LoadAsync();
  }

  private Task LoadAsync() => RunAsync(async () =>
  {
    await LoadUnitsAsync();
    _sections = (await Api.ListSectionsAsync()).OrderBy(s => s.Name).ToList();
  }, toast: false);

  private RenderFragment Table(List<SectionDto> rows, bool moved) => @<div class="sh-scroll">
    <table class="sh-table mud-typography-body2">
      <thead>
        <tr>
          <th>@L["Name"]</th>
          <th>@L["Kind"]</th>
          <th>@L["Categories"]</th>
          <th>@L["Auto-assign (min)"]</th>
          <th>@L["Grace (min)"]</th>
          @if (moved)
          {
            <th>@L["Unit"]</th>
          }
        </tr>
      </thead>
      <tbody>
        @foreach (var section in rows)
        {
          <tr @key="section.Id">
            <td dir="auto">@section.Name</td>
            <td>@(section.Kind == SectionKind.Department ? L["Department"] : L["Category section"])</td>
            <td>@(section.Kind == SectionKind.Department ? L["All categories"] : string.Join(", ", section.Categories))</td>
            <td>@(section.AutoAssignDelayMinutes?.ToString(CultureInfo.InvariantCulture) ?? L["default"])</td>
            <td>@(section.CheckoutGraceMinutes?.ToString(CultureInfo.InvariantCulture) ?? L["default"])</td>
            @if (moved)
            {
              <td><a href="shifts?unit=@section.MovedToUnitId">@UnitName(section.MovedToUnitId)</a></td>
            }
          </tr>
        }
      </tbody>
    </table>
  </div>;
}
