@page "/shifts"
@inherits ShiftsPageBase

@*
  Shifts Management: the tenant's shifts in one of three views (the schedule, GET /api/shifts/shifts?sectionId&from;
  my shifts, GET /api/shifts/shifts/mine; overdue, GET /api/shifts/shifts/overdue) and the "New shift" form
  (POST /api/shifts/shifts). A row opens the shift. Sections are on their own page.
*@

<PageHeader Title="@L["Shifts Management"]" />

<div class="mud-container sh-page">
  <header class="sh-header">
    <div>
      <p class="mud-typography mud-typography-body1 sh-muted">
        @L["Plan your organisation's shifts, put people on the rota and publish them: a published shift gives its members their role's permissions on the section's categories while it runs. Members check out when they are done."]
      </p>
    </div>
    <div class="sh-actions">
      <div class="mud-input-control sh-inline">
        <label class="mud-input-label" for="sh-view">@L["View"]</label>
        <div class="mud-input-wrapper mud-input-wrapper--select mud-input-wrapper--dense">
          <select id="sh-view" class="mud-input-slot" value="@_view" @onchange="ViewChangedAsync">
            <option value="@View.Schedule">@L["Schedule"]</option>
            <option value="@View.Mine">@L["My shifts"]</option>
            <option value="@View.Overdue">@L["Overdue"]</option>
          </select>
        </div>
      </div>
      @if (_view == View.Schedule)
      {
        <div class="mud-input-control sh-inline">
          <label class="mud-input-label" for="sh-filter">@L["Section"]</label>
          <div class="mud-input-wrapper mud-input-wrapper--select mud-input-wrapper--dense">
            <select id="sh-filter" class="mud-input-slot" value="@_sectionId" @onchange="SectionChangedAsync">
              <option value="">@L["All sections"]</option>
              @foreach (var section in _sections.OrderBy(s => s.Name))
              {
                <option value="@section.Id">@(section.Kind == SectionKind.Department ? L["{0} (department)", section.Name] : section.Name)</option>
              }
            </select>
          </div>
        </div>
        <div class="mud-input-control sh-inline">
          <label class="mud-input-label" for="sh-from">@L["From"]</label>
          <div class="mud-input-wrapper mud-input-wrapper--dense">
            <input id="sh-from" type="date" class="mud-input-slot" value="@_from.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" @onchange="FromChangedAsync" />
          </div>
        </div>
      }
      <a href="shifts/sections" class="mud-button-root mud-button-outlined mud-button-primary mud-button-medium">@L["Sections"]</a>
      <button type="button" class="mud-button-root mud-button-outlined mud-button-primary mud-button-medium" @onclick="LoadAsync" disabled="@Busy">@L["Refresh"]</button>
      <button type="button" class="mud-button-root mud-button-filled mud-button-primary mud-button-medium" @onclick="OpenCreate" disabled="@Busy">@L["New shift"]</button>
    </div>
  </header>

  <div class="sh-facts">
    <span class="sh-chip">@L["Shifts"] <strong>@_shifts.Count</strong></span>
    @foreach (var group in _shifts.GroupBy(Status).OrderBy(g => Array.IndexOf(Statuses, g.Key)))
    {
      <span class="sh-chip @(group.Key == "Running" ? "sh-chip-on" : group.Key == "Overdue" ? "sh-chip-warn" : "")">@L[group.Key] <strong>@group.Count()</strong></span>
    }
  </div>

  @if (Error is not null)
  {
    <p class="mud-typography mud-typography-body2 sh-error" role="alert">@Error</p>
  }

  @if (_form is not null)
  {
    <ShiftEditor Form="_form" Sections="_sections" Busy="Busy" Me="@Me" OnSave="CreateAsync" OnCancel="() => _form = null" />
  }

  <section class="mud-paper mud-elevation-1 sh-card">
    <MudTailDataTable @ref="_table" Columns="Columns" OnRowClick="OpenShift" EmptyText="@EmptyText" />
  </section>
</div>

@code {
  private enum View { Schedule, Mine, Overdue }

  private IReadOnlyList<object> Columns =>
  [
    new { key = "id", title = L["#"].Value, type = "number", width = "80px" },
    new { key = "section", title = L["Section"].Value },
    new { key = "starts", title = L["Starts"].Value },
    new { key = "ends", title = L["Ends"].Value },
    new { key = "rota", title = L["Rota"].Value, type = "number", width = "90px" },
    new { key = "status", title = L["Status"].Value, type = "enum", options = Statuses.Select(s => L[s].Value).ToArray(), width = "190px" },
  ];

  private MudTailDataTable? _table;
  private View _view = View.Schedule;
  private string _sectionId = "";
  private DateTime _from = DateTime.Today;
  private List<ShiftDto> _shifts = [];
  private List<SectionDto> _sections = [];
  private ShiftForm? _form;

  // One text for every view: the table reads it once, when it is created.
  private string EmptyText => L["No shifts in this view."];

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender) await LoadAsync();
  }

  private async Task LoadAsync()
  {
    await RunAsync(async () =>
    {
      var api = Api;
      _sections = (await api.ListSectionsAsync()).ToList();
      var shifts = _view switch
      {
        View.Mine => await api.ListMineAsync(),
        View.Overdue => await api.ListOverdueAsync(),
        _ => await api.ListShiftsAsync(int.TryParse(_sectionId, out var id) ? id : null,
          new DateTimeOffset(DateTime.SpecifyKind(_from, DateTimeKind.Local))),
      };
      _shifts = shifts.OrderBy(s => s.StartsAt).ToList();
      if (_table is not null) await _table.SetDataAsync(_shifts.Select(ToRow).ToList());
    });
  }

  private object ToRow(ShiftDto s) => new
  {
    id = s.Id.ToString(),
    section = s.Section,
    starts = When(s.StartsAt),
    ends = When(s.EndsAt),
    rota = s.Rota.Count,
    status = L[Status(s)].Value,
  };

  private async Task ViewChangedAsync(ChangeEventArgs e)
  {
    if (Enum.TryParse<View>(e.Value?.ToString(), out var view)) _view = view;
    await LoadAsync();
  }

  private async Task SectionChangedAsync(ChangeEventArgs e)
  {
    _sectionId = e.Value?.ToString() ?? "";
    await LoadAsync();
  }

  private async Task FromChangedAsync(ChangeEventArgs e)
  {
    if (DateTime.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture,
      System.Globalization.DateTimeStyles.None, out var from)) _from = from;
    await LoadAsync();
  }

  private void OpenCreate() => _form = ShiftForm.New(_sections, Me);

  private void OpenShift(string id) => Nav.NavigateTo($"shifts/{Uri.EscapeDataString(id)}");

  private async Task CreateAsync(ShiftForm form)
  {
    ShiftDto? created = null;
    var ok = await RunAsync(async () =>
    {
      created = await Api.AddShiftAsync(form.ToRequest());
      await MudTail.ToastAsync(L["Shift #{0} planned. Publish it from its page.", created.Id], "success");
      _form = null;
    });
    if (ok && created is not null) OpenShift(created.Id.ToString());
  }
}
