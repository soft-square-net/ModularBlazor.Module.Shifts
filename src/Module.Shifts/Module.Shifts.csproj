<Project Sdk="Microsoft.NET.Sdk.Razor">
  <Sdk Name="soft.square.net.ModularBlazor.Module.Sdk" />

  <!--
    Shifts Management: the Blazor client module of the Shifts module, loaded by ModularBlazor.BlzWebClient. Sections
    (the categories a desk covers), the shift schedule, planning a shift and its rota, publishing it (which writes the
    rota's time-windowed grants) and checking out, over the Shifts API.

    Shipped as soft.square.net.Module.Shifts.dll alone (the client part of this repo's bundle). The API client is its
    own hidden client module (WebApi.Modules.Shifts.Client, listed in Dependencies): referenced here to compile, never
    copied (Private=false). The host provides ModularBlazor.Abstractions (the Module SDK, with MudTail's components),
    Microsoft.Extensions.Http and the WebAssembly authentication package.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.*" PrivateAssets="all" />
    <!-- IStringLocalizer<T>: the host provides it (and reads this module's i18n/{culture}.json). -->
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.*" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.*" PrivateAssets="all" />
    <ProjectReference Include="..\WebApi.Modules.Shifts.Client\WebApi.Modules.Shifts.Client.csproj" Private="false" />
  </ItemGroup>

  <!-- Translations: i18n/{culture}.json as the resources "i18n/{culture}.json" (Module SDK 1.0.0-preview.4 and later
       embed them by itself; the same item there replaces this one). Keys are the English texts. -->
  <ItemGroup>
    <Content Remove="i18n/**" />
    <None Remove="i18n/**" />
    <EmbeddedResource Include="i18n/*.json" LogicalName="i18n/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
