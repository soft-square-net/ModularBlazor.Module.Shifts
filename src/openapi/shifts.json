{
  "openapi": "3.1.1",
  "info": {
    "title": "Shifts",
    "description": "Newsroom shifts: sections, rota (Manager, Desk, Editor), check-out; the rota becomes time-windowed grants.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/shifts/sections": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "operationId": "Shifts_ListSections",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SectionDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Shifts"
        ],
        "summary": "Adds a section. 409 once the sections moved to Organization (read-only: add Section units there).",
        "operationId": "Shifts_AddSection",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SectionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SectionDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/sections/serving": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "summary": "The sections that serve a category: the category's own sections first, then every department (they serve all categories).",
        "operationId": "Shifts_ListServingSections",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SectionDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/sections/{id}": {
      "put": {
        "tags": [
          "Shifts"
        ],
        "summary": "Changing the categories or the kind rewrites the grants of the section's published shifts that have not ended. 409 once the sections moved to Organization (read-only).",
        "operationId": "Shifts_UpdateSection",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SectionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SectionDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/sections/{id}/settings": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "summary": "Effective AutoAssignDelay and CheckoutGrace: the section's override, else the module's settings.",
        "operationId": "Shifts_GetSectionSettings",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SectionSettings"
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/sections/export": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "summary": "Every section with the Section unit to create for it in Organization and the unit it moved to, if any. Create the units, then link them with POST /sections/move-to-organization (links).",
        "operationId": "Shifts_ExportSections",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SectionsExport"
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/sections/move-to-organization": {
      "post": {
        "tags": [
          "Shifts"
        ],
        "summary": "Creates a Section unit under the Department parentUnitId for each section (with the caller's token; a department section gets the tag 'department' and the category '*'), or links the units given in links. Maps the section, moves its shifts to the unit and publishes shifts.section-moved.v1. Idempotent; one result per section. The sections are read-only afterwards.",
        "operationId": "Shifts_MoveSectionsToOrganization",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MoveSectionsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SectionMoveReport"
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/units": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "summary": "The tenant's Organization units as this module caches them (from org events and the unit directory), by path.",
        "operationId": "Shifts_ListUnits",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UnitDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/units/resync": {
      "post": {
        "tags": [
          "Shifts"
        ],
        "summary": "Reads the tenant's units from Organization's local directory (with the caller's token) and replaces the cache: newer versions are applied, units no longer listed are dropped.",
        "operationId": "Shifts_ResyncUnits",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnitResyncResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/mine": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "summary": "Your running and upcoming shifts (next 7 days).",
        "operationId": "Shifts_ListMine",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ShiftDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/overdue": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "summary": "Published shifts past their end that nobody checked out (for the workflow's automatic check-out).",
        "operationId": "Shifts_ListOverdue",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ShiftDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/shifts": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "operationId": "Shifts_ListShifts",
        "parameters": [
          {
            "name": "sectionId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ShiftDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Shifts"
        ],
        "summary": "Plans a shift with its rota (exactly one Manager). Its unit: unitId (a cached Organization unit), or the unit its section moved to; a section that has not moved yet may plan shifts without a unit. Nothing is granted until it is published.",
        "operationId": "Shifts_AddShift",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShiftRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShiftDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/shifts/{id}": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "operationId": "Shifts_GetShift",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShiftDto"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Shifts"
        ],
        "operationId": "Shifts_UpdateShift",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShiftRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShiftDto"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Shifts"
        ],
        "operationId": "Shifts_DeleteShift",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/shifts/shifts/{id}/automation": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "summary": "Shift clock and section-specific assignment/check-out timers for the workflow service.",
        "operationId": "Shifts_GetShiftAutomation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShiftAutomationInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/shifts/{id}/publish": {
      "post": {
        "tags": [
          "Shifts"
        ],
        "summary": "Writes the rota's grants: each member's role permissions on the section's categories, valid for the shift only.",
        "operationId": "Shifts_PublishShift",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShiftDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/shifts/{id}/check-out": {
      "post": {
        "tags": [
          "Shifts"
        ],
        "summary": "Handover: the whole shift checks out and every member's grants end now (the shift's manager, or a shift admin).",
        "operationId": "Shifts_CheckOutShift",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShiftDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/shifts/{id}/members/{userId}/check-out": {
      "post": {
        "tags": [
          "Shifts"
        ],
        "summary": "One member leaves early; their grants end now (themselves, the shift's manager, or a shift admin).",
        "operationId": "Shifts_CheckOutMember",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShiftDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MoveSectionsRequest": {
        "required": [
          "parentUnitId"
        ],
        "type": "object",
        "properties": {
          "parentUnitId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "links": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/SectionUnitLink"
            }
          }
        }
      },
      "RotaEntry": {
        "required": [
          "userId",
          "role"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/ShiftRole"
          }
        }
      },
      "RotaMemberDto": {
        "required": [
          "userId",
          "role",
          "checkedOutAt",
          "accessEnds"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/ShiftRole"
          },
          "checkedOutAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "accessEnds": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SectionDto": {
        "required": [
          "id",
          "name",
          "kind",
          "categories",
          "autoAssignDelayMinutes",
          "checkoutGraceMinutes"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/SectionKind"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "autoAssignDelayMinutes": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "checkoutGraceMinutes": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          }
        }
      },
      "SectionExportItem": {
        "required": [
          "sectionId",
          "name",
          "kind",
          "categories",
          "shifts",
          "unit",
          "movedToUnitId"
        ],
        "type": "object",
        "properties": {
          "sectionId": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/SectionKind"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "shifts": {
            "type": "integer",
            "format": "int32"
          },
          "unit": {
            "$ref": "#/components/schemas/SectionUnitDraft"
          },
          "movedToUnitId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "SectionKind": {
        "enum": [
          "Category",
          "Department"
        ],
        "type": "string"
      },
      "SectionMoveItem": {
        "required": [
          "sectionId",
          "name",
          "kind",
          "status",
          "unitId",
          "shiftsMoved",
          "detail"
        ],
        "type": "object",
        "properties": {
          "sectionId": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/SectionKind"
          },
          "status": {
            "$ref": "#/components/schemas/SectionMoveStatus"
          },
          "unitId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "shiftsMoved": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SectionMoveReport": {
        "required": [
          "parentUnitId",
          "sections"
        ],
        "type": "object",
        "properties": {
          "parentUnitId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SectionMoveItem"
            }
          }
        }
      },
      "SectionMoveStatus": {
        "enum": [
          "Created",
          "AlreadyMapped",
          "Linked",
          "Failed"
        ],
        "type": "string"
      },
      "SectionRequest": {
        "required": [
          "name",
          "categories",
          "autoAssignDelayMinutes",
          "checkoutGraceMinutes"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "autoAssignDelayMinutes": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "checkoutGraceMinutes": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "kind": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SectionKind"
              }
            ]
          }
        }
      },
      "SectionSettings": {
        "required": [
          "sectionId",
          "autoAssignDelay",
          "checkoutGrace"
        ],
        "type": "object",
        "properties": {
          "sectionId": {
            "type": "integer",
            "format": "int32"
          },
          "autoAssignDelay": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": "string"
          },
          "checkoutGrace": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": "string"
          }
        }
      },
      "SectionsExport": {
        "required": [
          "exportedAt",
          "sections"
        ],
        "type": "object",
        "properties": {
          "exportedAt": {
            "type": "string",
            "format": "date-time"
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SectionExportItem"
            }
          }
        }
      },
      "SectionUnitDraft": {
        "required": [
          "typeKey",
          "nameEn",
          "nameAr",
          "tags",
          "categories"
        ],
        "type": "object",
        "properties": {
          "typeKey": {
            "type": "string"
          },
          "nameEn": {
            "type": "string"
          },
          "nameAr": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SectionUnitLink": {
        "required": [
          "sectionId",
          "unitId"
        ],
        "type": "object",
        "properties": {
          "sectionId": {
            "type": "integer",
            "format": "int32"
          },
          "unitId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ShiftAutomationInfo": {
        "required": [
          "shiftId",
          "sectionId",
          "startsAt",
          "endsAt",
          "checkedOutAt",
          "autoAssignDelay",
          "checkoutGrace"
        ],
        "type": "object",
        "properties": {
          "shiftId": {
            "type": "integer",
            "format": "int32"
          },
          "sectionId": {
            "type": "integer",
            "format": "int32"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "checkedOutAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "autoAssignDelay": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": "string"
          },
          "checkoutGrace": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
