{
  "openapi": "3.1.1",
  "info": {
    "title": "Shifts",
    "description": "Newsroom shifts: units, rota roles as data, templates, check-out; the rota becomes time-windowed grants.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/shifts/sections": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "operationId": "Shifts_ListSections",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SectionDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Shifts"
        ],
        "summary": "Adds a section. 409 once the sections moved to Organization (read-only: add Section units there).",
        "operationId": "Shifts_AddSection",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SectionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SectionDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/sections/serving": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "summary": "The sections that serve a category: the category's own sections first, then every department (they serve all categories).",
        "operationId": "Shifts_ListServingSections",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SectionDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/sections/{id}": {
      "put": {
        "tags": [
          "Shifts"
        ],
        "summary": "Changing the categories or the kind rewrites the grants of the section's published shifts that have not ended. 409 once the sections moved to Organization (read-only).",
        "operationId": "Shifts_UpdateSection",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SectionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SectionDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/sections/{id}/settings": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "summary": "Effective AutoAssignDelay and CheckoutGrace: the section's override, else the module's settings.",
        "operationId": "Shifts_GetSectionSettings",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SectionSettings"
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/sections/export": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "summary": "Every section with the Section unit to create for it in Organization and the unit it moved to, if any. Create the units, then link them with POST /sections/move-to-organization (links).",
        "operationId": "Shifts_ExportSections",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SectionsExport"
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/sections/move-to-organization": {
      "post": {
        "tags": [
          "Shifts"
        ],
        "summary": "Creates a Section unit under the Department parentUnitId for each section (with the caller's token; a department section gets the tag 'department' and the category '*'), or links the units given in links. Maps the section, moves its shifts to the unit and publishes shifts.section-moved.v1. Idempotent; one result per section. The sections are read-only afterwards.",
        "operationId": "Shifts_MoveSectionsToOrganization",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MoveSectionsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SectionMoveReport"
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/units": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "summary": "The tenant's Organization units as this module caches them (from org events and the unit directory), by path.",
        "operationId": "Shifts_ListUnits",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UnitDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/units/resync": {
      "post": {
        "tags": [
          "Shifts"
        ],
        "summary": "Reads the tenant's units from Organization's local directory (with the caller's token) and replaces the cache: newer versions are applied, units no longer listed are dropped.",
        "operationId": "Shifts_ResyncUnits",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnitResyncResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/roles": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "summary": "Every rota role definition of the tenant: the tenant-wide ones (unitId null) and every unit's overrides.",
        "operationId": "Shifts_ListRoles",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RoleDefinitionDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Shifts"
        ],
        "summary": "Adds a rota role: its key (a lowercase slug), names, the permissions it grants while a shift runs (from the platform's permission catalog) and whether it is the shift's lead. Tenant-wide (no unitId; needs shifts.manage tenant-wide) or for a unit and the units below it (needs shifts.manage on the unit).",
        "operationId": "Shifts_AddRole",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoleDefinitionDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/roles/effective": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "summary": "The roles a rota of the unit can use: for each key, the definition nearest to the unit up its path (the unit's, a parent's, else the tenant's). Without unitId: the tenant-wide ones.",
        "operationId": "Shifts_ListEffectiveRoles",
        "parameters": [
          {
            "name": "unitId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RoleDefinitionDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/roles/{id}": {
      "put": {
        "tags": [
          "Shifts"
        ],
        "summary": "Changes a role's names, permissions and lead flag (its key and unit stay). Published shifts that use it and have not ended get their grants rewritten. The lead flag cannot change while shifts or templates use the role (409).",
        "operationId": "Shifts_UpdateRole",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoleUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoleDefinitionDto"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Shifts"
        ],
        "summary": "Removes a role definition. Refused (409) while shifts that have not ended or templates use it, unless another definition of the same key and lead flag (a parent unit's or the tenant's) takes over for them.",
        "operationId": "Shifts_DeleteRole",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/shifts/templates": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "operationId": "Shifts_ListTemplates",
        "parameters": [
          {
            "name": "unitId",
            "in": "query",
