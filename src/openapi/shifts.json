      "post": {
        "tags": [
          "Shifts"
        ],
        "summary": "Adds a shift template to a unit (needs shifts.manage on the unit): start (wall-clock, unit time zone), duration (at most 24h), role slots and default members (members of the unit or a unit above it; at most one in a lead role).",
        "operationId": "Shifts_AddTemplate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TemplateRequest"
              }
            }
