<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="soft.square.net.ModularBlazor.Module.Sdk" />

  <!--
    Use cases: one folder per use case (Shifts/Add, Shifts/Publish, Shifts/CheckOut, ...), each a Mediator command or
    query and its handler, returning an Ardalis Result. Also the module's permissions, settings, the rota's role
    templates and the DTOs.
    References Core and Shifts.Contracts (the event records it publishes). The Module SDK compiles it against WebApi.SharedKernel, WebApi.Contracts (IAccessScopes,
    IGrantStore, permissions) and ASP.NET Core, all provided by the host. Mediator.Abstractions and Ardalis.Result are
    private: copied into the module's output and loaded in its own load context, so they unload with it.
    The name does not end in .Application, so the layer is set here.
  -->

  <PropertyGroup>
    <ModuleLayer>Application</ModuleLayer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ardalis.Result" Version="$(ArdalisResultVersion)" />
    <PackageReference Include="Mediator.Abstractions" Version="$(MediatorVersion)" />
    <!-- Private, like the two above: the org.* event records, IUnitDirectory and the Organization API client. -->
    <PackageReference Include="soft.square.net.Organization.Contracts" Version="$(OrganizationPackagesVersion)" />
    <PackageReference Include="soft.square.net.Organization.Client" Version="$(OrganizationPackagesVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebApi.Modules.Shifts.Core\WebApi.Modules.Shifts.Core.csproj" />
    <!-- The module's own public contract (shifts.* event records, live names), copied into the output like the packages. -->
    <ProjectReference Include="..\Shifts.Contracts\Shifts.Contracts.csproj" />
  </ItemGroup>

</Project>
